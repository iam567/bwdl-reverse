.DS_Store
*.jar
__pycache__/
*.pyc
.claude/
work/

# Unity 构建产物
unity/*/Build/
unity/*/Library/
unity/*/Temp/
unity/*/Logs/

# 不能随 App 分发的商用字体（Arial Unicode MS），只留在本机
unity/*/FontsRetired/
# Unity 批处理日志
unity/*/*.log

# 安卓出包时由 Builder.WriteManifest() 生成的素材清单（2797 行，派生文件）
unity/*/Assets/StreamingAssets/Art/_manifest.txt
unity/*/Assets/StreamingAssets/Art/_manifest.txt.meta
# Unity 批处理留下的临时目录
unity/*/.utmp/
